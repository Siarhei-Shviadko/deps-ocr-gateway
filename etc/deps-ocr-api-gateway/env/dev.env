ENV=local
PROJECT_VERSION=0.2.0
## Number of workers
WORKERS=1
## Reload worker if any code changes
RELOAD=false
## Maximum number of requests that worker can handle
MAX_REQUESTS=1000
## Timeout for one request (in seconds)
TIMEOUT=600

# Auth
AUTH_ENABLED=true
AUTH_VERIFY_SSL=false

# OCR configuration
## auth key for GCP Vision engine
GCP_VISION_AUTH_KEY=

# Performance configuration

## Number of threads used by TESSERACT for OCR.
## Should be configured to increase TESSERACT performance.
OMP_THREAD_LIMIT=2

## Preinitialize engines when running system.
## While enable, it will consume more resources after start
## but takes less time for the first document processing run.
OCR_ENGINES_PREINIT=false

## Use GPU for OCR images.
# OCR_ENABLE_CUDA_GPU=false

# Sentry settings
SENTRY_ENABLED=false
SENTRY_TRACE_ENABLED=false
SENTRY_DSN=

## Set debug to true for local development and running
DEBUG=false

AWS_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

AZURE_FORM_RECOGNIZER_API_URL=
AZURE_FORM_RECOGNIZER_API_KEY=

# asb kafka rabbitmq
MESSAGING_DRIVER=rabbitmq
MESSAGE_BROKER_CONNECTION_STRING=amqp://deps-rabbitmq:deps-rabbitmq-password@deps-rabbitmq:5672/deps
RABBITMQ_DLX_PER_QUEUE=false

# Kafka
KAFKA_GROUP_ID=ocr

LOG_LEVEL=INFO

#engine_urls
TESSERACT_URL=http://tesseract-engin:8000
AWS_TEXTRACT_URL=http://aws-textract-engin:8000
GCP_VISION_URL=http://gcp-vision-engin:8000
AZURE_FORM_RECOGNIZER_URL=http://azure-form-recognizer-engin:8000

FILE_STORAGE_URL=http://deps-file-storage:8004/api/storage/v1/file
OCR_GATEWAY_URL=http://ocr-gateway:8000

VERIFY_SSL=false

## List of enabled OCR engines
TESSERACT_ENABLED=true
GCP_VISION_ENABLED=false
AWS_TEXTRACT_ENABLED=false
AZURE_FORM_RECOGNIZER_ENABLED=true

PAID_ENGINES_RESTRICTION_ENABLED=false
PRIVILEGED_GROUP=deps-admins

TESSERACT_TIMEOUT=60
GCP_VISION_TIMEOUT=60
AWS_TEXTRACT_TIMEOUT=60
AZURE_FORM_RECOGNIZER_TIMEOUT=60
